  {
   "id": "placsp_cruce_comunidad",
   "titulo": "PLACSP: lo adjudicado por comunidad (cruce de resultados y licitaciones)",
   "mide": "JOIN de 5,9 M de lotes con 5,2 M de licitaciones por id y fecha_updated, y dos agregaciones",
